<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vscode_input_bg" />
            <corners android:radius="3dp" />
            <stroke
                android:width="1dp"
                android:color="@color/vscode_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vscode_input_bg" />
            <corners android:radius="3dp" />
            <stroke
                android:width="1dp"
                android:color="@color/vscode_border" />
        </shape>
    </item>
</selector>
